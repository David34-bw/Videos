# URL de la app (local)
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google Cloud Console → Credenciales → ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave de API (restringida a Google Picker API) para el selector de fotos
NEXT_PUBLIC_GOOGLE_API_KEY=
# Número de proyecto de Google Cloud (App ID del Picker)
NEXT_PUBLIC_GOOGLE_APP_ID=
# true = pide permiso de solo lectura a todo Drive para usar carpetas completas
# false = solo las fotos que elijas en el selector (más privado)
GOOGLE_DRIVE_FULL_READ=false

# País para calcular Día de la Madre/Padre, Amor y Amistad: CO, MX, US, ES
NEXT_PUBLIC_COUNTRY=CO

# Opcional: análisis de estilo con IA (API de Claude, de pago por uso)
ANTHROPIC_API_KEY=

# Opcional: rutas a binarios si no están en el PATH
FFMPEG_PATH=
FFPROBE_PATH=
YT_DLP_PATH=
# Opcional: Chrome/Chromium ya instalado para renderizar (si no, Remotion lo descarga)
REMOTION_BROWSER_EXECUTABLE=
